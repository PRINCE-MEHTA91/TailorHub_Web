# ─── Server Config ────────────────────────────────────────────────────────────
PORT=3000

# Set to 'production' for deployment. Controls secure cookies, error verbosity, IS_PROD flag.
NODE_ENV=development

# ─── Python Measurement Service ───────────────────────────────────────────────
# Local: http://localhost:5001/measure
# Production: https://tailorhub-python.onrender.com/measure
PYTHON_MEASURE_URL=http://localhost:5001/measure

# ─── JWT ──────────────────────────────────────────────────────────────────────
# REQUIRED: Must be at least 32 characters. Server will REFUSE to start if missing.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_char_random_secret_here

# ─── Neon PostgreSQL ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ─── Gmail SMTP ───────────────────────────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── Frontend URL ─────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3001

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins (beyond localhost + CLIENT_URL)
# Example: ALLOWED_ORIGINS=https://tailorhub.vercel.app,https://www.tailorhub.in
ALLOWED_ORIGINS=

# ─── Google Gemini AI (Primary) ──────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# Model options: gemini-2.5-flash (default, free), gemini-2.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── OpenRouter AI (Legacy — not required) ────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
